# =============================================================================
# LiteLLM Proxy 环境变量配置
# =============================================================================
#
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 替换所有占位密钥为实际的安全密钥
#   3. 生产环境必须修改以下三项（默认值不安全）：
#      - LITELLM_MASTER_KEY
#      - LITELLM_SALT_KEY
#      - POSTGRES_PASSWORD
#
# 生成安全密钥：
#   python -c "import secrets; print('sk-' + secrets.token_hex(32))"   # Master Key
#   python -c "import secrets; print(secrets.token_hex(32))"           # Salt Key
#   python -c "import secrets; print(secrets.token_urlsafe(24))"       # DB Password
# =============================================================================

# ===== 必填（生产环境必须更换默认值） =====

# LiteLLM Master Key — 管理后台和管理 API 的认证密钥
# ⚠️ 安全警告：默认值仅用于本地开发，生产环境必须更换！
LITELLM_MASTER_KEY=sk-litellm-master-key

# PostgreSQL 密码
# ⚠️ 安全警告：默认值仅用于本地开发，生产环境必须更换！
POSTGRES_PASSWORD=litellm_pass

# LiteLLM 加密盐值 — 用于加密存储 API Key
# ⚠️ 安全警告：默认值仅用于本地开发，生产环境必须更换！
LITELLM_SALT_KEY=litellm-salt-key

# ===== LLM API Keys（按需填写） =====

# OpenAI API Key（用于 GPT-4o-mini 等模型）
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key（用于 Claude 等模型）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google AI API Key（用于 Gemini 等模型）
# GEMINI_API_KEY=your-gemini-api-key

# 自定义 LLM 服务（如本地 Ollama、vLLM 等）
# 不需要 API Key，可通过管理 UI 添加
